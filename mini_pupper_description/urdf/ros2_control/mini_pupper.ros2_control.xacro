<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="pupper_joint" params="joint_name initial_value use_gazebo_hardware">
    <joint name="${joint_name}">
      <xacro:if value="${use_gazebo_hardware}">
        <command_interface name="position_pid"/>
        <!-- Gains tuned for sim_inertia_scale=100 (links are 100x heavier inertially).
             Joint effective I (hip+distal) ~1.3e-4 kg*m^2, knee ~4.8e-5 kg*m^2.
             Stability constraint: kd &lt; 2*I/dt_physics ~0.096 (use 0.05 with margin).
             kp=5.0 gives ~22 ms settling vs 200 ms at kp=1 (within 1-2 gait ticks). -->
        <param name="pos_kp">5.0</param>
        <param name="pos_kd">0.05</param>
      </xacro:if>
      <xacro:unless value="${use_gazebo_hardware}">
        <command_interface name="position"/>
      </xacro:unless>
      <state_interface name="position">
        <param name="initial_value">${initial_value}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="mini_pupper_ros2_control" params="use_gazebo_hardware">
    <xacro:if value="${use_gazebo_hardware}">
      <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
          <parameters>$(find mini_pupper_simulation)/config/ros2_control/mini_pupper_2_controllers_sim.yaml</parameters>
          <hold_joints>false</hold_joints>
        </plugin>
      </gazebo>
    </xacro:if>

    <ros2_control name="MiniPupper" type="system">
      <hardware>
        <xacro:if value="${use_gazebo_hardware}">
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
          <param name="hold_joints">true</param>
        </xacro:if>
        <xacro:unless value="${use_gazebo_hardware}">
          <plugin>mini_pupper_hardware/MiniPupperHardware</plugin>
          <param name="hardware_interface_type">esp32_proxy</param>
        </xacro:unless>
      </hardware>

      <xacro:pupper_joint joint_name="base_lf1" initial_value="${startup_abduction_left}" use_gazebo_hardware="${use_gazebo_hardware}"/>
      <xacro:pupper_joint joint_name="lf1_lf2"  initial_value="${startup_hip}"       use_gazebo_hardware="${use_gazebo_hardware}"/>
      <xacro:pupper_joint joint_name="lf2_lf3"  initial_value="${startup_knee}"      use_gazebo_hardware="${use_gazebo_hardware}"/>
      <xacro:pupper_joint joint_name="base_rf1" initial_value="${startup_abduction_right}" use_gazebo_hardware="${use_gazebo_hardware}"/>
      <xacro:pupper_joint joint_name="rf1_rf2"  initial_value="${startup_hip}"       use_gazebo_hardware="${use_gazebo_hardware}"/>
      <xacro:pupper_joint joint_name="rf2_rf3"  initial_value="${startup_knee}"      use_gazebo_hardware="${use_gazebo_hardware}"/>
      <xacro:pupper_joint joint_name="base_lb1" initial_value="${startup_abduction_left}" use_gazebo_hardware="${use_gazebo_hardware}"/>
      <xacro:pupper_joint joint_name="lb1_lb2"  initial_value="${startup_hip}"       use_gazebo_hardware="${use_gazebo_hardware}"/>
      <xacro:pupper_joint joint_name="lb2_lb3"  initial_value="${startup_knee}"      use_gazebo_hardware="${use_gazebo_hardware}"/>
      <xacro:pupper_joint joint_name="base_rb1" initial_value="${startup_abduction_right}" use_gazebo_hardware="${use_gazebo_hardware}"/>
      <xacro:pupper_joint joint_name="rb1_rb2"  initial_value="${startup_hip}"       use_gazebo_hardware="${use_gazebo_hardware}"/>
      <xacro:pupper_joint joint_name="rb2_rb3"  initial_value="${startup_knee}"      use_gazebo_hardware="${use_gazebo_hardware}"/>
    </ros2_control>
  </xacro:macro>
</robot>
