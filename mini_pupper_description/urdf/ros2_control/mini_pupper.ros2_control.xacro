<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="mini_pupper_ros2_control" params="use_gazebo_hardware:=^|true">
    <gazebo>
      <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
        <parameters>$(find mini_pupper_description)/config/ros2_control/mini_pupper_2_controllers.yaml</parameters>
      </plugin>
    </gazebo>

    <ros2_control name="MiniPupper" type="system">
      <xacro:if value="${use_gazebo_hardware}">
        <hardware>
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
          <param name="hold_joints">true</param>
        </hardware>
      </xacro:if>
      <xacro:unless value="${use_gazebo_hardware}">
        <hardware>
          <plugin>mini_pupper_hardware/MiniPupperHardware</plugin>
          <param name="hardware_interface_type">esp32_proxy</param>
        </hardware>
      </xacro:unless>

      <joint name="base_lf1">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${startup_abduction}</param>
        </state_interface>
      </joint>
      <joint name="lf1_lf2">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${startup_hip}</param>
        </state_interface>
      </joint>
      <joint name="lf2_lf3">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${startup_knee}</param>
        </state_interface>
      </joint>
      <joint name="base_rf1">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${startup_abduction}</param>
        </state_interface>
      </joint>
      <joint name="rf1_rf2">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${startup_hip}</param>
        </state_interface>
      </joint>
      <joint name="rf2_rf3">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${startup_knee}</param>
        </state_interface>
      </joint>
      <joint name="base_lb1">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${startup_abduction}</param>
        </state_interface>
      </joint>
      <joint name="lb1_lb2">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${startup_hip}</param>
        </state_interface>
      </joint>
      <joint name="lb2_lb3">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${startup_knee}</param>
        </state_interface>
      </joint>
      <joint name="base_rb1">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${startup_abduction}</param>
        </state_interface>
      </joint>
      <joint name="rb1_rb2">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${startup_hip}</param>
        </state_interface>
      </joint>
      <joint name="rb2_rb3">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${startup_knee}</param>
        </state_interface>
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
