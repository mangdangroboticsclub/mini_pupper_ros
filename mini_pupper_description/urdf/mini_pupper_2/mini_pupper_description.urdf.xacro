  <joint name="base_cn2" type="fixed">
    <origin xyz="0.042355 0.0235 0.0" rpy="0 0 0"/>
    <parent link="Board_PCB"/>
    <child link="Board_connectors_2"/>
  </joint>

  <joint name="pcb_lidar" type="fixed">
    <origin xyz="0.009 0.024 0.042" rpy="0 0 1.57" />
    <parent link="Board_PCB" />
    <child link="lidar_link" />
  </joint>

  <joint name="rf3_foot" type="fixed">
    <origin xyz="0 0 -0.056" rpy="0 0 0"/>
    <parent link="rf3"/>
    <child link="rffoot"/>
  </joint>

  <joint name="rb3_foot" type="fixed">
    <origin xyz="0 0 -0.056" rpy="0 0 0"/>
    <parent link="rb3"/>
    <child link="rbfoot"/>
  </joint>

  <joint name="lb3_foot" type="fixed">
    <origin xyz="0 0 -0.056" rpy="0 0 0"/>
    <parent link="lb3"/>
    <child link="lbfoot"/>
  </joint>

  <joint name="lf3_foot" type="fixed">
    <origin xyz="0 0 -0.056" rpy="0 0 0"/>
    <parent link="lf3"/>
    <child link="lffoot"/>
  </joint>

  <joint name="lf1_hip" type="fixed">
    <origin xyz="0.01076 0.0307 0.013" rpy="0 0 0"/>
    <parent link="lf1"/>
    <child link="lpf1"/>
  </joint>

  <joint name="lb1_hip" type="fixed">
    <origin xyz="0.01076 0.0307 0.013" rpy="0 0 0"/>
    <parent link="lb1"/>
    <child link="lpb1"/>
  </joint>

  <joint name="rf1_hip" type="fixed">
    <origin xyz="0.01076 -0.0307 0.013" rpy="0 0 0"/>
    <parent link="rf1"/>
    <child link="rpf1"/>
  </joint>

  <joint name="rb2_hip" type="fixed">
    <origin xyz="0.01076 -0.0307 0.013" rpy="0 0 0"/>
    <parent link="rb1"/>
    <child link="rpb1"/>
  </joint>

  <joint name="lf2_shell" type="fixed">
    <origin xyz="0 0.01 -0.05" rpy="0 0 0"/>
    <parent link="lf2"/>
    <child link="lpf2"/>
  </joint>

  <joint name="lb2_shell" type="fixed">
    <origin xyz="0 0.01 -0.05" rpy="0 0 0"/>
    <parent link="lb2"/>
    <child link="lpb2"/>
  </joint>

  <joint name="rf2_shell" type="fixed">
    <origin xyz="0 -0.01 -0.05" rpy="0 0 0"/>
    <parent link="rf2"/>
    <child link="rpf2"/>
  </joint>

  <joint name="rb2_shell" type="fixed">
    <origin xyz="0 -0.01 -0.05" rpy="0 0 0"/>
    <parent link="rb2"/>
    <child link="rpb2"/>
  </joint>

  <joint name="base_sides" type="fixed">
    <origin xyz="-0.002701 -0.030005 -0.016293" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="Shell_Side"/>
  </joint>
  <!-- coloring Gazebo model -->
  <gazebo reference="base_link">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="Board_PCB">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="Body_front">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="Shell_Side">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="Board_connectors_1">
    <material>Gazebo/Orange</material>
  </gazebo>
  <gazebo reference="Board_connectors_2">
    <material>Gazebo/White</material>
  </gazebo>
  
  <gazebo reference="lf1">
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="lpf1">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="lf2">
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="lpf2">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="lf3">
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="rf1">
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="rpf1">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="rf2">
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="rpf2">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="rf3">
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="lb1">
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="lpb1">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="lb2">
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="lpb2">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="lb3">
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="rb1">
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="rpb1">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="rb2">
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="rpb2">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="rb3">
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <maxVel>0.0</maxVel>
    <minDepth>0.001</minDepth>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>Gazebo/FlatBlack</material>
    <sensor type="ray" name="lidar">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>1040</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>6.28</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>50.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.004</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name> 
      </plugin>
    </sensor>
  </gazebo> 

  <gazebo>
    <plugin filename="libgazebo_ros_p3d.so" name="p3d_base_controller">
      <body_name>base_link</body_name>
      <frame_name>odom</frame_name>
      <update_rate>10.0</update_rate>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
      <gaussian_noise>0.01</gaussian_noise>
    </plugin>
  </gazebo>
  
  <link name="imu_link">
    <inertial>
      <mass value="0.0001"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="${1e-09 * sim_body_inertia_scale}" ixy="${0.0 * sim_body_inertia_scale}" ixz="${0.0 * sim_body_inertia_scale}" iyy="${1e-09 * sim_body_inertia_scale}" iyz="${0.0 * sim_body_inertia_scale}" izz="${1e-09 * sim_body_inertia_scale}"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_controller" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <plugin name="gazebo_ros_imu_sensor" filename="libgazebo_ros_imu_sensor.so">
          <ros>
              <namespace>/imu</namespace>
              <remapping>~/out:=data</remapping>
          </ros>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Simulated camera mounted to the front body -->
  <link name="camera_link">
    <visual>
      <geometry>
          <box size="0.02 0.02 0.02" />
      </geometry>
      <material name="Cyan">
        <color rgba="0 1.0 1.0 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="bodyfront_camera_joint" type="fixed">
    <parent link="Body_front"/>
    <child link="camera_link"/>
    <origin xyz="0.02 0 0.02" rpy="0 0 0"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor type="camera" name="sim_camera">
      <always_on>true</always_on>
      <update_rate>30.0</update_rate>
      <visualize>true</visualize>

      <camera name="camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>50</far>
        </clip>
      </camera>

      <!-- Gazebo ROS plugin to publish /image_raw -->
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <frame_name>camera_link</frame_name>
        <image_topic_name>/image_raw</image_topic_name>
        <!-- camera_info omitted to disable /camera_info -->
      </plugin>
    </sensor>
  </gazebo>

  <xacro:mini_pupper_ros2_control use_gazebo_hardware="$(arg use_gazebo_hardware)" />

  <!-- Conditional debug support stand -->
  <xacro:if value="$(arg use_debug_stand)">
    <xacro:include filename="$(find mini_pupper_description)/urdf/ros2_control/support_stand.debug.xacro" />
    <xacro:support_stand_debug robot_base_link="base_link"/>
  </xacro:if>
</robot>