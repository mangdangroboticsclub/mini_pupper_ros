<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mini_pupper_gazebo</name>
  <version>2.0.0</version>
  <description>Mini Pupper Gazebo simulation package for ROS2 Jazzy</description>
  <maintainer email="maintainer@mangdang.net">MangDang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>mini_pupper_description</depend>
  <depend>mini_pupper_bringup</depend>
  <depend>robot_state_publisher</depend>
  <depend>xacro</depend>
  <!-- Jazzy uses gz-sim (Gazebo Harmonic) instead of gazebo_ros -->
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>ros_gz_image</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
